# Copy to .env.local. All keys stay on the server. Never commit .env.local.
APP_HOST=127.0.0.1
PORT=3000
NEXT_TELEMETRY_DISABLED=1

# Phase 2: GitHub public repository search. Token is optional, no private scope needed.
GITHUB_ENABLED=true
GITHUB_API_URL=https://api.github.com
GITHUB_TOKEN=

# Phase 3: mainland-friendly default; choose bocha, tavily or none.
WEB_SEARCH_PROVIDER=bocha
BOCHA_API_URL=https://api.bochaai.com/v1/web-search
BOCHA_API_KEY=
TAVILY_API_URL=https://api.tavily.com/search
TAVILY_API_KEY=

# Phase 4: bilibili uses the configured web search index; youtube uses official API.
VIDEO_SEARCH_PROVIDER=bilibili
YOUTUBE_API_URL=https://www.googleapis.com/youtube/v3
YOUTUBE_API_KEY=

# Phase 5: relative to the project root, preserved across builds.
DATABASE_PATH=./data/knowledgehub.db
SEARCH_CACHE_TTL_MINUTES=60

# Phase 6: JSON Chat Completions compatible API. Disabled/unconfigured -> rules only.
AI_ENABLED=true
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-flash
# Only for localhost models that do not require a key.
AI_ALLOW_NO_KEY=false
AI_TIMEOUT_MS=20000

SEARCH_TIMEOUT_MS=12000
SEARCH_RESULT_LIMIT=8
# Actual search phrases per provider, 1-3. 2 means up to 8 search API requests.
EXPANSION_SEARCH_LIMIT=2
