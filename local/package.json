{
  "name": "knowledgehub-ai",
  "version": "0.6.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "node --env-file-if-exists=.env.local scripts/start.mjs",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run test:unit && node --test tests/http.test.mjs",
    "check": "npm run lint && npm run typecheck && npm run build && npm test",
    "test:unit": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "prebuild": "node scripts/clean-standalone.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "type": "module",
  "displayName": "KnowledgeHub AI"
}
