# Online edition: configure production secrets through Sites runtime settings.
# This example is for development only. Never commit real keys.
GITHUB_ENABLED=true
GITHUB_API_URL=https://api.github.com
GITHUB_TOKEN=
WEB_SEARCH_PROVIDER=bocha
BOCHA_API_URL=https://api.bochaai.com/v1/web-search
BOCHA_API_KEY=
TAVILY_API_URL=https://api.tavily.com/search
TAVILY_API_KEY=
VIDEO_SEARCH_PROVIDER=bilibili
YOUTUBE_API_URL=https://www.googleapis.com/youtube/v3
YOUTUBE_API_KEY=
AI_ENABLED=true
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-flash
AI_ALLOW_NO_KEY=false
AI_TIMEOUT_MS=20000
SEARCH_TIMEOUT_MS=12000
SEARCH_CACHE_TTL_MINUTES=60
SEARCH_RESULT_LIMIT=8
EXPANSION_SEARCH_LIMIT=2
# D1 binding DB is declared in .openai/hosting.json; no local SQLite path.
